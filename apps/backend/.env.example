# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Authentication (generate a private random secret of at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# PostgreSQL container and local backend connection
POSTGRES_DB=gamenest
POSTGRES_USER=gamenest
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gamenest.dev
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-password
